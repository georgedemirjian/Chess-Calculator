# Training data — raw PGNs and processed CSVs can be hundreds of GB
training/data/raw/*.pgn
training/data/raw/*.state.json
training/data/raw/_sampling_state.json
training/data/*.csv
training/data/*.parquet

# ML model artifacts — small enough (~3 MB) to commit so deployments have them.
# (Re-add this ignore if you start training models too large for git.)
# backend/ml/*.joblib

# Claude Code internal memory
memory/
