# Copy this file to .env and fill in values for your machine.

# Absolute path to the Stockfish binary
# macOS (Homebrew):  /opt/homebrew/bin/stockfish
# Linux:             /usr/bin/stockfish
# Windows:           C:\stockfish\stockfish.exe
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Analysis depth per position — higher is more accurate but slower.
# 18 is a good MVP default (~0.1–0.3 s/move on modern hardware).
STOCKFISH_DEPTH=18

# Origins allowed to call this API (CORS). Comma-separated, no trailing slash.
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
# Both:       http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
